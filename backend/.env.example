# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/feelinga_tea

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_REFRESH_EXPIRES_IN=7d

# Cookie/session security
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com
ENFORCE_HTTPS=false

# Frontend URL (CORS)
CLIENT_URL=http://localhost:3000

# Primary admin account
ADMIN_EMAIL=admin@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here

# Email
EMAIL_FROM="Feelinga Tea" <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# MFA
ENFORCE_LOGIN_MFA=true
MFA_TOKEN_EXPIRES_IN=10m
MFA_CODE_TTL_MS=600000
MFA_MAX_ATTEMPTS=5
LOGIN_LOCK_MS=900000

# Password breach checks (HaveIBeenPwned k-anonymity API)
HIBP_ENFORCE=false
HIBP_MIN_BREACH_COUNT=1
HIBP_TIMEOUT_MS=4000
HIBP_CACHE_TTL_MS=21600000
HIBP_FAIL_CLOSED=false
HIBP_USER_AGENT=Feelinga-Security-Check

# External mailbox verification (Hunter Email Verifier API)
EMAIL_VERIFIER_PROVIDER=none
HUNTER_API_KEY=
HUNTER_TIMEOUT_MS=8000
HUNTER_REJECT_UNKNOWN=false
HUNTER_REJECT_GIBBERISH=true
HUNTER_FAIL_OPEN=true
HUNTER_USER_AGENT=Feelinga-Email-Verification

# Razorpay (Phase 2)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

