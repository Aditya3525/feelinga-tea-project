# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/serene_tea

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-this
JWT_REFRESH_EXPIRES_IN=7d

# Frontend URL (CORS)
CLIENT_URL=http://localhost:3000

# Primary admin account
ADMIN_EMAIL=admin@example.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here

# Email
EMAIL_FROM="Feelinga Tea" <noreply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Razorpay (Phase 2)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
